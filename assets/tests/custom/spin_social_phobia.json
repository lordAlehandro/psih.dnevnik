{
  "id": "spin",
  "category": "anxiety",
  "title": {
    "ru": "SPIN — инвентарь социальной фобии",
    "en": "SPIN — Social Phobia Inventory",
    "fr": "SPIN — Inventaire de phobie sociale",
    "de": "SPIN — Soziale-Phobie-Inventar",
    "pt": "SPIN — Inventário de fobia social"
  },
  "subtitle": {
    "ru": "Страх и избегание социальных ситуаций за последнюю неделю.",
    "en": "Fear and avoidance in social situations over the past week.",
    "fr": "Peur et évitement en situation sociale sur la semaine passée.",
    "de": "Angst und Vermeidung in sozialen Situationen in der letzten Woche.",
    "pt": "Medo e evitação em situações sociais na última semana."
  },
  "description": {
    "ru": "Самооценка симптомов социальной тревоги (страх, избегание, телесные проявления). Не заменяет клиническую диагностику. Права на оригинальную методику принадлежат авторам; при использовании в работе указывайте первоисточник.",
    "en": "Self-rated social anxiety (fear, avoidance, somatic symptoms). Not a diagnosis. The original instrument is copyrighted; cite the primary publication for academic use.",
    "fr": "Auto-évaluation de l’anxiété sociale. Pas un diagnostic. Instrument protégé ; citez la publication.",
    "de": "Selbstbeurteilung sozialer Ängste. Keine Diagnose. Urheberrechtlich geschützt; Originalpublikation zitieren.",
    "pt": "Autoavaliação de ansiedade social. Não é diagnóstico. Instrumento com direitos autorais; cite a publicação."
  },
  "instructions": {
    "ru": "Укажите, насколько каждая проблема беспокоила вас на прошедшей неделе.",
    "en": "Indicate how much each problem has bothered you during the past week.",
    "fr": "Indiquez à quel point chaque problème vous a gêné(e) au cours de la dernière semaine.",
    "de": "Geben Sie an, wie sehr Sie in der letzten Woche unter jedem Problem gelitten haben.",
    "pt": "Indique o quanto cada problema o incomodou na última semana."
  },
  "maxScore": 68,
  "bandsBasis": "raw",
